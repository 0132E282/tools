{
  "name": "tools-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "install:all": "pnpm install --frozen-lockfile",
    "start": "cd api && nest start",
    "start:dev": "pnpm dev",
    "start:debug": "cd api && nest start --debug --watch",
    "start:prod": "node api/dist/main.js",
    "build:api": "cd api && nest build",
    "build:client": "tsc --noEmit -p Client/tsconfig.json && vite build --config Client/vite.config.ts Client",
    "build": "pnpm run build:api && pnpm run build:client",
    "preview": "vite preview --config Client/vite.config.ts Client",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run lint:api && pnpm run lint:client",
    "lint:api": "cd api && oxlint --type-aware src/ test/",
    "lint:client": "oxlint Client/src/ Client/vite.config.ts",
    "format": "prettier --write \"api/src/**/*.ts\" \"api/test/**/*.ts\" \"Client/src/**/*.{ts,tsx,css}\"",
    "test": "vitest run --config vitest.config.api.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:watch": "vitest --config vitest.config.api.ts",
    "test:cov": "vitest run --config vitest.config.api.ts --coverage",
    "vercel-build": "pnpm run build",
    "check:vercel": "node scripts/check-vercel-startup.mjs",
    "dev": "cd api && TOOLS_CLIENT_DEV=true nest start --watch",
    "test:client": "vitest run --config Client/vitest.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/typeorm": "12.0.2",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "5.2.1",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^1.52.0",
    "mysql2": "3.24.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tailwind-merge": "^3.7.0",
    "typeorm": "1.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/mau": "0.2.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.15.0"
}
